# Template environment produksi. Salin ke .env di server, lalu sesuaikan.
# Jangan pernah commit .env yang sudah terisi (sudah masuk .gitignore).

APP_NAME=SULTRAKLIK
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://sultraklik.id

# Locale konten situs: seluruh UI, seed, dan teks redaksi memakai bahasa Indonesia.
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Level "debug" di produksi membanjiri disk dengan isi request dan env.
LOG_LEVEL=warning

# .env.example bawaan Laravel menyebut SQLite, tapi project ini berjalan di MySQL.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sultraklik
DB_USERNAME=sultraklik
DB_PASSWORD=

# Sesi, antrean, dan cache semuanya lewat tabel database, jadi tidak butuh
# service tambahan. Tabelnya dibuat oleh migration framework.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie aman diaktifkan otomatis oleh AppServiceProvider selama APP_URL https.
# Kalau APP_URL masih http, ganti juga setelan di bawah secara manual.
# SESSION_SECURE_COOKIE=true

# Di belakang Cloudflare, request yang sampai ke Laravel berasal dari IP edge
# Cloudflare. Tanpa daftar ini, rate limit komentar/like/login akan menghitung
# semua pengunjung sebagai satu IP yang sama, dan cookie sesi tidak akan
# memakai flag "secure".
#
# Hanya rentang resmi Cloudflare yang dipercaya, supaya X-Forwarded-For palsu
# dari orang yang mencoba mencapai origin secara langsung tetap diabaikan.
# Sumber: https://www.cloudflare.com/ips-v4 dan https://www.cloudflare.com/ips-v6
# Kosongkan kalau aplikasi diakses tanpa Cloudflare.
TRUSTED_PROXIES="173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22,2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="redaksi@sultraklik.id"
MAIL_FROM_NAME="${APP_NAME}"

# Dipakai UserSeeder untuk membuat satu-satunya akun super admin.
# Password WAJIB minimal 12 karakter; di APP_ENV=production seeder berhenti
# kalau kosong atau terlalu pendek, tidak pernah membuat password default.
# Hapus SUPER_ADMIN_PASSWORD dari .env setelah akun pertama berhasil dibuat.
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@sultraklik.id
SUPER_ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
